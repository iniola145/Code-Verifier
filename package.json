{
  "name": "code-verifier",
  "version": "1.0.0",
  "description": "Static Application Security Testing (SAST) and Abstract Interpretation engine for React, React Native, Expo, and TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./jest-reporter": "./dist/adapters/jest-reporter.js",
    "./vitest-plugin": "./dist/adapters/vitest-plugin.js",
    "./jest-setup": "./dist/adapters/jest-setup.js"
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "code-verifier": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "verify": "ts-node src/cli.ts",
    "mcp": "ts-node src/mcp-server.ts",
    "test": "ts-node test/run-tests.ts",
    "benchmark": "ts-node test/benchmark.ts"
  },
  "keywords": [
    "sast",
    "abstract-interpretation",
    "react-native",
    "expo",
    "security",
    "llm-tools",
    "code-verifier"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.5",
    "@types/node": "^20.11.0",
    "@types/react": "^19.3.0",
    "ts-node": "^10.9.2"
  }
}
