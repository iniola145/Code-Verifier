export function forward<T>(value: T): T {
  return value;
}

export function emptyUser() {
  return null;
}

function privateForward<T>(value: T): T {
  return value;
}

export { privateForward as renamedForward };

export default function defaultForward<T>(value: T): T {
  return value;
}

export function persist(value: string) {
  AsyncStorage.setItem('cache', value);
}
